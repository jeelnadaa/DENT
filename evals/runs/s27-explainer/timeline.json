 "cues": [
  {
   "s": 0.9,
   "e": 6.714,
   "t": "A password is a secret you hand\nover. To every site, every time."
  },
  {
   "s": 7.114,
   "e": 11.228,
   "t": "Sites keep copies. Fake\nsites ask just as nicely."
  },
  {
   "s": 11.628,
   "e": 16.193,
   "t": "A passkey isn't a secret you share. It's\na signature only your device can make."
  },
  {
   "s": 16.593,
   "e": 20.253,
   "t": "Your device makes a pair of\nkeys. The private key never"
  },
  {
   "s": 20.253,
   "e": 24.312,
   "t": "leaves it, and only your face,\nfingerprint or PIN unlocks it."
  },
  {
   "s": 24.712,
   "e": 27.669,
   "t": "The site keeps only the public key. It can"
  },
  {
   "s": 27.669,
   "e": 30.627,
   "t": "check your signature, but never forge one."
  },
  {
   "s": 31.027,
   "e": 33.397,
   "t": "To sign in, the site sends a fresh"
  },
  {
   "s": 33.397,
   "e": 37.091,
   "t": "challenge. Your device signs\nit, and the site checks."
  },
  {
   "s": 37.491,
   "e": 43.079,
   "t": "No secret crosses the wire. A\nstolen public key signs no one in."
  },
  {
   "s": 43.479,
   "e": 48.616,
   "t": "Each passkey is bound to the real site's\ndomain. A lookalike gets nothing."
  },
  {
   "s": 49.016,
   "e": 53.358,
   "t": "Your keychain or password manager\nsyncs them across your devices."
  },
  {
   "s": 53.758,
   "e": 59.909,
   "t": "Stop handing over secrets. Look for\n\"Create a passkey\" in your settings."
  }
 ]
